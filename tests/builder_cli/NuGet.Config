<?xml version="1.0" encoding="utf-8"?>
<!-- (No packages: the checks build the Builder's own Runner.cs and BuilderHome.cs and nothing else. One exception, nuget.org
     for the Windows Desktop targeting pack only: a Windows SDK carries it, but a Linux runner building net8.0-windows with
     EnableWindowsTargeting has to fetch it, and with every source cleared the restore fails with NU1100 before a check runs.
     Package source mapping keeps every other package off nuget.org.) -->
<configuration>
  <packageSources>
    <clear/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.WindowsDesktop.App.Ref"/>
    </packageSource>
  </packageSourceMapping>
</configuration>
