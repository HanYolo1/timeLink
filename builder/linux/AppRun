#!/bin/sh
# The timeLink AppImage: the Linux builder, for the command line. Its Python, timeLink's sources and nx2/make_game.py (the
# player's build compiles the Vulkan back end from them too). It has no window: players use the timeLink Launcher, which
# unpacks this AppImage and runs make_game.py with its Python. The build tools (clang and lld, a glibc 2.35 sysroot, FFmpeg, SDL2, the Vulkan headers) are
# tools.lock's linux-x64 lines, outside the image: builder/linux/linux_tools.py finds them (the timeLink Launcher's, or the
# builder's own toolchains folder) and, for --cli, downloads what is missing.
#   timeLink.AppImage --cli <args>     nx2/make_game.py itself, e.g. --cli --nup game.nup --out ~/Games/timeLink
#                                      (RecompLauncher's prepare: --cli --prepare --game <copy>)
#   timeLink.AppImage --play           start the game in ~/Games/timeLink
#   timeLink.AppImage --play <folder>  start the game in that folder (RecompLauncher's start)
#   timeLink.AppImage <folder>         the same
#   timeLink.AppImage --launch <dir>  the same (a game folder's timeLink, builder/linux/timeLink-folder, when --cli built it)
#   timeLink.AppImage                  a message: get the timeLink Launcher
HERE="$(dirname "$(readlink -f "$0")")"
export TIMELINK_TOOLS="$HERE/usr/share/timeLink"
# (written into the game folder's timeLink_version.txt, so its launcher finds this builder)
if [ -n "${APPIMAGE:-}" ]; then
    export TIMELINK_BUILDER_EXE="$APPIMAGE"
else
    export TIMELINK_BUILDER_EXE="$HERE/AppRun"
fi
PY="$HERE/usr/python/bin/python3"
# The build tools' places (EMSDK, TIMELINK_SYSROOT, TIMELINK_FFMPEG, TIMELINK_SDL2, RX_CPM), each downloaded first when it is
# missing, its progress on stderr. A tool that cannot be had stops --cli
build_tools() {
    tools_env=$("$PY" -I "$TIMELINK_TOOLS/builder/linux/linux_tools.py" env --install) && tools_ok=1 || tools_ok=
    eval "$tools_env"
    [ -n "$tools_ok" ]
}
if [ "${1:-}" = "--cli" ]; then
    shift
    build_tools || exit 1
    exec "$PY" -I "$TIMELINK_TOOLS/nx2/make_game.py" "$@"
fi
# Play is the same AppImage: the start script drops this image's libraries, then runs the built game. It needs no build tool.
if [ "${1:-}" = "--play" ]; then
    shift
    exec "$TIMELINK_TOOLS/builder/linux/timeLink-launch" "$@"
fi
if [ "${1:-}" = "--launch" ] && [ -n "${2:-}" ] && [ -d "$2" ]; then
    exec "$TIMELINK_TOOLS/builder/linux/timeLink-launch" "$2"
fi
if [ -n "${1:-}" ] && [ -d "$1" ]; then
    exec "$TIMELINK_TOOLS/builder/linux/timeLink-launch" "$1"
fi
# Anything else (started from the applications menu or a file manager): no window, a message
MESSAGE="The timeLink Builder has no window of its own: the timeLink Launcher builds the game and starts it. Get the launcher from https://longshot.magicbean.dev/download"
echo "$MESSAGE" >&2
if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ ! -t 2 ]; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="timeLink Builder" --text="$MESSAGE" >/dev/null 2>&1 || true
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title "timeLink Builder" --msgbox "$MESSAGE" >/dev/null 2>&1 || true
    fi
fi
exit 1
