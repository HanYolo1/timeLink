# ---- never commit the game or anything made from it ----
# (decompressed modules, the loaded image, lifted C, test builds, romfs/exefs copies, dumps, keys)
work/
gen/
image/
exefs/
romfs/
*.bin
*.keys
# (release keys: never in the repository. The launcher's signing key is a *.pem, and it is not a game file, so *.keys above
# does not cover it. scripts/release.py keygen writes release.pem and release.pub.pem into a folder of its own; this stops one
# made inside the tree from being added by `git add -A`)
*.pem
# (but the launcher's test fixture is a throwaway key its tests sign a fixture release with: it is meant to be public and is
# already tracked, so this keeps it that way)
!launcher/tests/fixtures/release/*.pem
*.nso
*.nca
*.nsp
*.xci
gamefile/
*.nup
*.nsz
*.xcz

# ---- build output and caches ----
build/
build-tools-cache/
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.sha1
*.log

# ---- Linux builds ----
build-linux/
*.so

# ---- NVIDIA's DLSS SDK (scripts/ngx_sdk.py): NVIDIA's files, never committed ----
ngx-sdk/
